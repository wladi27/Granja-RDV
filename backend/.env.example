# Application
NODE_ENV=development
APP_NAME=grv-api
PORT=3002
API_PREFIX=api
TIMEZONE=America/Bogota
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# Produccion (ejemplo): https://tu-frontend.vercel.app,https://*.vercel.app

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_NAME=grv
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=10000

# PG Boss (native PostgreSQL queue)
PG_BOSS_SCHEMA=pgboss
PG_BOSS_ARCHIVE_COMPLETED_AFTER_SECONDS=86400
PG_BOSS_DELETE_AFTER_DAYS=7
PG_BOSS_NEW_JOB_CHECK_INTERVAL_SECONDS=2
PG_BOSS_COMMISSION_QUEUE=commission.process
PG_BOSS_RETRY_LIMIT=5
PG_BOSS_RETRY_DELAY_SECONDS=30

# Auth
JWT_ACCESS_SECRET=replace-me-access-secret
JWT_REFRESH_SECRET=replace-me-refresh-secret
JWT_ACCESS_TTL=60m
JWT_REFRESH_TTL=30d
DELIVERY_CONFIRMATION_TTL=12h
BCRYPT_SALT_ROUNDS=12
ADMIN_FULL_NAME=Administrador GRV
ADMIN_EMAIL=admin@grv.local
ADMIN_PASSWORD=Admin12345!

# Wallet and business defaults
MIN_WITHDRAWAL_COP=50000
DEFAULT_GRACE_PERIOD_DAYS=3
MAX_COMMISSION_LEVELS=10
DELIVERY_COMMISSION_PERCENT=0

# Cache and realtime
CACHE_TTL_SECONDS=300
CACHE_CHECK_PERIOD_SECONDS=60
WS_ENABLED=true

# Files / evidence
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
